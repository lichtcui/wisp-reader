# harmony-device-run 的仓库专属命令（随仓库提交）。
# 修改后跑一次：~/Documents/skills.harmony/setup-codex.sh --force .
# 完整闭环见根目录 Makefile 的 run / install / restart / log 目标。
HARMONY_BUILD_COMMANDS=$'make hap > /tmp/build.log 2>&1   # 改了 Rust / NAPI 先 make test && make rust'
HARMONY_RUN_COMMANDS=$'make install          # 安装最新 HAP\nmake restart          # aa force-stop + 启动（aboutToAppear 才会重跑）\nmake log              # 按 bundle 名筛 hilog；可加 Q=关键词'
