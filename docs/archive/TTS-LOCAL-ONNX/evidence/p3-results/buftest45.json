{
  "audio_sec": 53.24,
  "chunks": [
    {
      "audio_sec": 7.38,
      "chars": 31,
      "idx": 0,
      "ms": 5677.8,
      "samples": 236160,
      "text": "清晨的阳光穿过窗帘的缝隙，落在木地板上，形成一道道明亮的条纹。"
    },
    {
      "audio_sec": 6.78,
      "chars": 31,
      "idx": 1,
      "ms": 5329.62,
      "samples": 216960,
      "text": "老街尽头的面包店每天六点开门，黄油和麦子的香味顺着巷子飘出来。"
    },
    {
      "audio_sec": 6.38,
      "chars": 30,
      "idx": 2,
      "ms": 4883.54,
      "samples": 204160,
      "text": "他把那本旧书翻到夹着书签的一页，纸页已经发黄，边角也卷起了。"
    },
    {
      "audio_sec": 6.7,
      "chars": 28,
      "idx": 3,
      "ms": 5376.47,
      "samples": 214400,
      "text": "雨水顺着屋檐连成一条条细线，落在青石板上溅起小小的水花。"
    },
    {
      "audio_sec": 7.42,
      "chars": 30,
      "idx": 4,
      "ms": 6088.99,
      "samples": 237440,
      "text": "远处的山峦在暮色中层层叠叠，颜色由青转紫，融进橘红色的晚霞。"
    },
    {
      "audio_sec": 5.62,
      "chars": 27,
      "idx": 5,
      "ms": 4801.7,
      "samples": 179840,
      "text": "她在信的最后写道，无论走到哪里，都要记得抬头看看天空。"
    },
    {
      "audio_sec": 6.14,
      "chars": 30,
      "idx": 6,
      "ms": 5182.64,
      "samples": 196480,
      "text": "风把窗帘吹得鼓起来，像一只白色的帆，慢慢滑过整个安静的午后。"
    },
    {
      "audio_sec": 6.82,
      "chars": 30,
      "idx": 7,
      "ms": 5867.14,
      "samples": 218240,
      "text": "他数着窗外的雨点，一滴两滴，直到困意像潮水一样漫过他的眼睛。"
    }
  ],
