+    /// Synthesize one chunk with the §8 duration guard and sentence-level retry.
+    ///
+    /// The guard threshold applies to the **predicted VITS waveform length**
+    /// (`1280 * semanticLen / 32000 s`), which is the span the constant tail
+    /// artefact can overlay — not the post-processed buffer, which still carries
+    /// the trailing fragment interval. A chunk over the threshold is retried up
+    /// to `max_retries` times (the artefact length is not reproducible, so a
+    /// retry usually lands under the threshold); a still-over chunk is reported
+    /// as `over_limit` for the host to hand to the system TTS.
+    pub fn synthesize_guarded(
+        &mut self,
+        text: &str,
+        sampling_param: SamplingParams,
+        lang_id: LangId,
+        postprocess_params: PostprocessParams,
+        max_audio_sec: f64,
+        max_retries: u32,
+    ) -> Result<GuardedChunk, GSVError> {
+        let mut attempts = 0u32;
+        let mut best: Option<(Vec<f32>, usize)> = None;
+        let over_limit = loop {
+            attempts += 1;
+            let (_spec, samples) =
+                self.synthesize_sync(text, sampling_param, lang_id, postprocess_params)?;
+            let speech_samples = samples
+                .len()
+                .saturating_sub(fragment_interval_samples(self.output_spec.sample_rate, postprocess_params.fragment_interval));
+            let semantic_len = (speech_samples / (2 * VITS_UPSAMPLE_RATE)).max(1);
+            let keep = vits_output_samples(semantic_len) as f64
+                / self.output_spec.sample_rate as f64
+                <= max_audio_sec;
+            if best.is_none() || keep {
+                best = Some((samples, semantic_len));
+            }
+            if keep || attempts > max_retries {
+                break !keep;
+            }
+        };
+        let (samples, semantic_len) = best.ok_or_else(|| GSVError::from("no audio produced"))?;
+        Ok(GuardedChunk {
+            samples,
+            semantic_len,
+            attempts,
+            over_limit,
+            recovered_by_retry: attempts > 1 && !over_limit,
+        })
+    }
+}
+
+/// Outcome of [`TTSModel::synthesize_guarded`].
+pub struct GuardedChunk {
+    pub samples: Vec<f32>,
+    pub semantic_len: usize,
+    pub attempts: u32,
+    pub over_limit: bool,
+    pub recovered_by_retry: bool,
+}
+
+fn fragment_interval_samples(sample_rate: u32, fragment_interval: f32) -> usize {
+    if fragment_interval > 0.0 {
+        (sample_rate as f32 * fragment_interval) as usize
+    } else {
+        0
+    }
 }
 
