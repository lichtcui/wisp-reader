@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""Add a ``model.safetensors`` next to a ``pytorch_model.bin`` checkpoint.
+
+transformers >= 4.54 refuses to ``torch.load`` plain ``.bin`` checkpoints unless
+torch >= 2.6 (CVE-2025-32434), but the final Intel-macOS torch wheel is 2.2.2.
+transformers prefers ``model.safetensors`` when present and never touches the
+version guard for that format, so we convert once and leave the original ``.bin``
+in place. Idempotent, and a no-op when the ``.bin`` is absent.
+"""
+
+from __future__ import annotations
+
+import argparse
+import pathlib
+import sys
+
+
+def convert(bin_path: pathlib.Path) -> int:
+    import torch
+    from safetensors.torch import save_file
+
+    out = bin_path.with_name("model.safetensors")
+    if out.exists():
+        print(f"[INFO] already present: {out}")
+        return 0
+
+    state = torch.load(bin_path, map_location="cpu", weights_only=True)
+    if not isinstance(state, dict):
+        state = state.get("state_dict", state)
+    state = {k: v.contiguous().clone() for k, v in state.items()}
+    save_file(state, out, metadata={"format": "pt"})
+    print(f"[INFO] wrote {out} ({len(state)} tensors)")
+    return 0
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("bin_paths", nargs="+", help="pytorch_model.bin paths")
+    args = parser.parse_args()
+    for raw in args.bin_paths:
+        path = pathlib.Path(raw)
+        if not path.is_file():
+            print(f"[INFO] skip (no such file): {path}")
+            continue
+        convert(path)
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main())
+    except Exception as exc:  # pragma: no cover - surfaced to the caller
+        print(f"[ERROR] safetensors conversion failed: {exc}", file=sys.stderr)
+        raise SystemExit(1)
diff --git a/scripts/export/lib/patch_torch_legacy_export.py b/scripts/export/lib/patch_torch_legacy_export.py
new file mode 100755
index 0000000..9f02f59
--- /dev/null
+++ b/scripts/export/lib/patch_torch_legacy_export.py
@@ -0,0 +1,131 @@
+#!/usr/bin/env python3
+"""Adapt the patched GPT-SoVITS ONNX exporter for PyTorch < 2.6 hosts.
+
+Why this exists
+---------------
+Upstream GPT-SoVITS / this repo's patch overlay targets PyTorch >= 2.6:
+
+  * ``torch.onnx.export`` gained the ``dynamo`` kwarg there (defaulting to the new
+    dynamo exporter), so the patched exporter passes ``{"dynamo": False}`` to stay
+    on the legacy TorchScript exporter these graphs are written for.
+  * transformers defaults to SDPA/efficient attention, which that exporter cannot
+    translate (``TypeError ... z_()`` on the fused attention path).
+  * It also pins ``opset_version=20``.
+
+PyTorch 2.2.2 is the final release with an Intel macOS (x86_64) wheel and predates
+all three. Every edit below is semantics-preserving:
+
+  * Dropping ``dynamo`` only removes a *disable* flag for an exporter that does not
+    exist yet -- the legacy exporter is already the default.
+  * Forcing ``attn_implementation="eager"`` selects plain ``matmul``/``softmax``
+    attention instead of SDPA. The math is identical (attention here is exact; the
+    dummy graph traces carry no masked/padded positions), and it is the only
+    formulation torch 2.2.2 can export.
+  * Lowering the export opset changes graph *representation*, not the model. The
+    downstream ``scripts/optimize_aio.py`` unconditionally runs
+    ``version_converter.convert_version(model, 21)`` on every artifact, so the final
+    bundle still lands at opset 21 exactly as on a 2.6+ host. 17 is the highest opset
+    torch 2.2.2 can *emit and validate*: it advertises 19, but emits legacy
+    ``ReduceMean(axes=...)`` attributes that only became an input at opset 18, so the
+    exporter's own checker rejects those graphs above 17. ``version_converter``
+    migrates the attribute/input split when it lifts the graph to 21.
+
+Idempotent, and scoped to the upstream clone only: ``patch/GPT_SoVITS/`` (the source
+overlay) is never touched, so ``02_patch.sh`` restores the pristine files if needed.
+"""
+
+from __future__ import annotations
+
+import argparse
+import pathlib
+import re
+import sys
+
+# target file (relative to GPT_SoVITS/) -> list of (pristine, replacement, note).
+# Replacements must be idempotent: re-running must not find the pristine snippet
+# again.
+REWRITES = {
+    "export_onnx_v2.py": [
+        (
+            '_LEGACY_ONNX_KWARGS = {"dynamo": False}',
+            "_LEGACY_ONNX_KWARGS = {}",
+            "dropped 'dynamo' kwarg",
+        ),
+        (
+            "bert_model = AutoModelForMaskedLM.from_pretrained(\n"
+            "        bert_path, output_hidden_states=True,\n"
+            "    )",
+            "bert_model = AutoModelForMaskedLM.from_pretrained(\n"
+            "        bert_path,\n"
+            "        output_hidden_states=True,\n"
+            '        attn_implementation="eager",\n'
+            "    )",
+            "BERT attention -> eager",
+        ),
+    ],
+    "feature_extractor/cnhubert.py": [
+        (
+            "HubertModel.from_pretrained(base_path, local_files_only=True)",
+            "HubertModel.from_pretrained(\n"
+            "            base_path, local_files_only=True, "
+            'attn_implementation="eager"\n'
+            "        )",
+            "SSL/HuBERT attention -> eager",
+        ),
+    ],
+}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("gpt_sovits_dir", help="path to the GPT_SoVITS directory")
+    parser.add_argument(
+        "--opset",
+        type=int,
+        default=None,
+        help="rewrite opset_version=20 to this value (e.g. 19)",
+    )
+    args = parser.parse_args()
+
+    root = pathlib.Path(args.gpt_sovits_dir)
+    if not root.is_dir():
+        print(f"[ERROR] not a directory: {root}", file=sys.stderr)
+        return 2
+
+    changed_any = False
+    for rel, rewrites in REWRITES.items():
+        path = root / rel
+        if not path.is_file():
+            print(f"[ERROR] missing expected file: {path}", file=sys.stderr)
+            return 3
+
+        original = text = path.read_text(encoding="utf-8")
+        notes: list[str] = []
+
+        for canonical, replacement, note in rewrites:
+            if canonical in text:
+                text = text.replace(canonical, replacement)
+                notes.append(note)
+
+        if args.opset is not None and rel == "export_onnx_v2.py":
+            pattern = re.compile(r"opset_version=(\d+)")
+            hits = pattern.findall(text)
+            if any(int(v) != args.opset for v in hits):
+                text = pattern.sub(f"opset_version={args.opset}", text)
+                notes.append(f"opset_version {sorted(set(hits))} -> {args.opset}")
+
+        if text == original:
+            print(f"[INFO] up to date: {rel}")
+            continue
+
+        path.write_text(text, encoding="utf-8")
+        changed_any = True
+        print(f"[INFO] adapted {rel}: " + "; ".join(notes))
+
+    if not changed_any:
+        print("[INFO] no changes needed")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
