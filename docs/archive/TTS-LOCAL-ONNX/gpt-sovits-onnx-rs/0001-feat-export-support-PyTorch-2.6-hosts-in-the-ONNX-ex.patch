+
+# PyTorch < 2.6 predates the `dynamo` kwarg in torch.onnx.export, which the
+# patched exporter (targeting 2.6+) always passes. Drop it on such hosts so the
+# legacy TorchScript path (the one GPT-SoVITS needs) is used as-is.
+patch_legacy_onnx_export() {
+    [[ -f "${GPT_SOVITS_ROOT}/GPT_SoVITS/export_onnx_v2.py" ]] || return 0
+    if [[ "$(run_python -c 'import torch; print(int(torch.__version__.split(".")[1]))')" -lt 6 ]]; then
+        log_info "PyTorch < 2.6 detected; applying legacy ONNX-export compatibility"
+        run_python "${EXPORT_LIB_DIR}/patch_torch_legacy_export.py" \
+            --opset "${LEGACY_EXPORT_OPSET:-17}" \
+            "${GPT_SOVITS_ROOT}/GPT_SoVITS"
+    fi
+}
+
+# transformers >= 4.54 blocks torch.load on .bin checkpoints for torch < 2.6
+# (CVE-2025-32434), and Intel macOS tops out at torch 2.2.2. Providing
+# model.safetensors alongside lets from_pretrained() use the safe format.
+ensure_pretrained_safetensors() {
+    local pretrained="${GPT_SOVITS_ROOT}/GPT_SoVITS/pretrained_models"
+    if [[ "$(run_python -c 'import torch; print(int(torch.__version__.split(".")[1]))')" -lt 6 ]]; then
+        run_python "${EXPORT_LIB_DIR}/ensure_safetensors.py" \
+            "${pretrained}/chinese-hubert-base/pytorch_model.bin" \
+            "${pretrained}/chinese-roberta-wwm-ext-large/pytorch_model.bin"
+    fi
+}
