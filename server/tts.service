[Unit]
Description=Source Reader remote TTS (sherpa-onnx ZipVoice)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/tts/server
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 9880 --workers 1
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# Set to the same value the app's "API Key" field sends.
Environment=X_API_KEY=
# num_steps=2 keeps RTF comfortably <1; =3 is cleaner (less onset grain) but tighter.
# NOTE: measured 2026-10-07 on this 4C VPS -- steps=2 RTF 0.56, steps=3 RTF 0.84,
# steps=6 RTF 1.49 (too slow for realtime). See docs/research/TTS-ENGINE-COMPARISON.md.
Environment=NUM_STEPS=3

# --- memory safety (added 2026-10-07) ---------------------------------------
# The box has 3.9G RAM and no swap used to be configured; it had already OOM-killed
# an unrelated `rustc` build. The old build also grew from 0.79G to 2.5G RSS over six
# days (a 44.1k->24k resampler was rebuilt on every request); that is fixed in app.py,
# but keep a hard ceiling so a regression restarts this service instead of taking down
# whatever else is running. 2G swap is configured in /etc/fstab.
MemoryHigh=1200M
MemoryMax=1600M
# Daily restart as a leak backstop; a restart costs ~7s of model load.
RuntimeMaxSec=86400

# Avoid thread oversubscription: NumThreads=4 for ONNX + numpy's FFT pool on a 4-core box.
Environment=OMP_NUM_THREADS=4
Environment=OPENBLAS_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
# glibc keeps freed memory in per-thread arenas; cap arenas and trim more eagerly.
Environment=MALLOC_ARENA_MAX=4
Environment=MALLOC_TRIM_THRESHOLD_=65536

[Install]
WantedBy=multi-user.target
